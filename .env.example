# Create a bot via @BotFather on Telegram to get the token.
TELEGRAM_BOT_TOKEN=

# Message your bot once, then GET https://api.telegram.org/bot<token>/getUpdates
# and read the chat id back from the response.
TELEGRAM_CHAT_ID=

# Resource limits (Docker Compose); adjust to the host's available RAM/CPU.
BOT_MEMORY_LIMIT=1g
BOT_CPUS=0.75
TELEGRAM_CHARTS=1
# Absolute overview/refresh timestamps, including daylight-saving changes.
TELEGRAM_TIMEZONE=Europe/Zagreb
TELEGRAM_CHART_DPI=150
CHART_CACHE_MAX_MB=8
LIVE_CACHE_TTL_SEC=300

# Optional FINRA browser fallback; default operation downloads FINRA's workbook directly.
# Start only if needed: docker compose --profile finra-browser up -d cfbypass
FINRA_BROWSER_MEMORY_LIMIT=1g
FINRA_BROWSER_CPUS=0.5

# Extra daily update before the regular close of London / IBIS2 (Xetra).
PRECLOSE_ENABLED=1
PRECLOSE_MINUTES=60

# Interactive Brokers, read only (README → Interactive Brokers). Client Portal → Reporting →
# Flex Queries: an Activity query's ID, and a Flex Web Service token locked to this server's IP.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
# The expiry chosen when generating the token (YYYY-MM-DD); /status and /portfolio warn 14 days ahead.
IBKR_FLEX_TOKEN_EXPIRES=
# Benchmark for /portfolio (a Yahoo symbol quoted in euros).
BUYSIGNAL_BENCHMARK=VWCE.DE
