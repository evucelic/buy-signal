# Create a bot via @BotFather on Telegram to get the token.
TELEGRAM_BOT_TOKEN=

# Message your bot once, then GET https://api.telegram.org/bot<token>/getUpdates
# and read the chat id back from the response.
TELEGRAM_CHAT_ID=

# Resource limits (Docker Compose); adjust to the host's available RAM/CPU.
BOT_MEMORY_LIMIT=1g
BOT_CPUS=0.75
TELEGRAM_CHARTS=1
TELEGRAM_CHART_DPI=120
CHART_CACHE_MAX_MB=8
LIVE_CACHE_TTL_SEC=300

# Optional FINRA browser fallback; default operation downloads FINRA's workbook directly.
# Start only if needed: docker compose --profile finra-browser up -d cfbypass
FINRA_BROWSER_MEMORY_LIMIT=1g
FINRA_BROWSER_CPUS=0.5
